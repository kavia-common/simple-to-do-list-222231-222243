# Frontend environment variables for To-do app

# Base URL for API (highest priority)
REACT_APP_API_BASE=http://localhost:4000

# Fallback backend URL if API_BASE not set
REACT_APP_BACKEND_URL=

# Frontend URL (used by integrations if needed)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Feature flags as JSON. Example to enable API mode:
# {"useApi": true}
REACT_APP_FEATURE_FLAGS={"useApi": false}
